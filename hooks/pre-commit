#!/usr/bin/env bash
# W5 slide 76: inspect staged blobs, not unstaged working-tree contents.
set -u
failed=0
while IFS= read -r -d '' path; do
    case "$path" in
        data/README.md) ;;
        data/*|.env|.env.*|*/.env|*/.env.*)
            printf 'BLOCKED: source data or local credentials: %s\n' "$path" >&2
            failed=1 ;;
    esac
    size=$(git cat-file -s ":$path") || exit 1
    if [ "$size" -gt 10485760 ]; then
        printf 'BLOCKED: file exceeds 10 MiB: %s (%s bytes)\n' "$path" "$size" >&2
        failed=1
    fi
    if git show ":$path" | LC_ALL=C grep -aEq 'ntn_[[:alnum:]]{20,}'; then
        printf 'BLOCKED: Notion token pattern in staged file: %s\n' "$path" >&2
        failed=1
    fi
done < <(git diff --cached --name-only --diff-filter=ACMR -z)
if [ "$failed" -ne 0 ]; then exit 1; fi
git diff --cached --check || exit 1
printf 'pre-commit: staged data, size, token and whitespace checks passed.\n'
